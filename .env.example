# Flask
FLASK_SECRET_KEY=change-me-to-a-random-secret
FLASK_DEBUG=1

# SQLite (metadata: users, warehouses, devices, sensors...)
DATABASE_URL=sqlite:///../instance/env_monitor.db

# InfluxDB (dữ liệu nhiệt độ - time series)
# Điền thông tin thật của instance InfluxDB đang chạy vào đây
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influx-token
INFLUX_ORG=your-org
INFLUX_BUCKET=your-bucket

# Schema giả định trong InfluxDB (chỉnh trong app/influx_client.py nếu khác):
#   measurement: temperature
#   tag: sensor_code
#   field: value
